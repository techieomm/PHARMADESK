# Supabase Configuration
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Production Mode & Data Provider (Set VITE_DEMO_MODE=false in production)
VITE_DEMO_MODE=false
VITE_DATA_PROVIDER=supabase

# Application Configuration
VITE_APP_NAME=Bajrang Pharmacy
VITE_DEFAULT_CURRENCY=INR
VITE_TIMEZONE=Asia/Kolkata

# Backend Scripts Configuration (For scripts/setup-master-admin.mjs ONLY)
# Create scripts/.env.local (gitignored) and define:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-client
